---
import '../styles/global.css';
import SEO from '../components/SEO.astro'; 

// 访客信息（来源、IP、时间、终端、信号）改为在访客浏览器中实时获取，见页面底部脚本。
// 原因：网站为静态构建，构建时无法取得访客请求头，只会得到固定的默认值。
---

<html lang="zh-CN">
<head>
    <SEO 
      title="ABOUT // 操作员信息" 
      description="了解 BA8BLK 电台及其操作员 Hui。这里记录了台站坐标四川 (OM21EC)、所用设备以及对业余无线电的热爱。"
      keywords="BA8BLK, 四川 HAM, 业余无线电操作员, OM21EC, 无线电台站介绍, 业余无线电技术"
    />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;700;900&family=JetBrains+Mono:wght@400;700&display=swap" />
</head>
<body class="bg-[#fbfbfb] text-[#171717] antialiased font-['JetBrains_Mono','Noto_Sans_SC']">
    
    <main class="max-w-2xl mx-auto px-6 pt-24 pb-32">
        <nav class="mb-16">
            <a href="/" class="text-xs font-bold text-black/30 hover:text-black transition-all flex items-center gap-2">
                <span>&larr;</span> RETURN_TO_CONSOLE
            </a>
        </nav>

        <section class="mb-20">
            <h1 class="text-4xl font-bold tracking-tight mb-6">ABOUT // OPERATOR_INFO</h1>  

            <article class="space-y-10 text-gray-800 leading-relaxed">
              
              <section>
                <p class="text-lg mb-2">
                  这里是 <span class="font-bold">BA8BLK</span>，一名位于中国第 8 区的业余无线电操作员。
                </p>
                <p class="text-sm text-gray-500 font-['JetBrains_Mono'] leading-snug">
                  This is <span class="font-bold">BA8BLK</span>, an amateur radio operator located in Zone 8, China.
                </p>
              </section>

              <section>
                <p class="text-lg mb-2">
                  本站是我个人的数字通联日志，记录关于无线电技术、代码开发以及生活中的零散信号。
                </p>
                <p class="text-sm text-gray-500 font-['JetBrains_Mono'] leading-snug">
                  This site serves as my personal digital logbook, capturing fragments of radio technology, code development, and the scattered signals of daily life.
                </p>
              </section>

              <section>
                <p class="text-lg mb-2">
                  我坚信在这个高度连接的时代，依然有些信号值得跨越山海去捕捉。
                </p>
                <p class="text-sm text-gray-500 font-['JetBrains_Mono'] leading-snug">
                  I firmly believe that in this hyper-connected era, there are still signals worth chasing across mountains and seas.
                </p>
              </section>

              <div class="border-l-4 border-[#38A169] pl-6 py-2 mt-12 bg-gray-50">
                <p class="text-gray-700 italic mb-1">
                  73 是我们最诚挚的敬意，是对远方友谊的最终确认。
                </p>
                <p class="text-xs text-gray-400 font-['JetBrains_Mono']">
                  73 is our sincerest regard, the ultimate confirmation of friendship from afar.
                </p>
              </div>

            </article>
        </section>

        <section class="border border-black/10 bg-black/[0.02] p-8 rounded-sm relative overflow-hidden">
            <div class="flex items-center justify-between mb-8">
                <div class="flex items-center gap-3">
                    <div class="relative flex h-3 w-3">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#059669] opacity-40"></span>
                        <span class="relative inline-flex rounded-full h-3 w-3 bg-[#059669]"></span>
                    </div>
                    <h2 class="text-xs font-bold tracking-[0.2em] text-[#059669] uppercase">Terminal_Signal_Monitor</h2>
                </div>
                <span class="text-[9px] font-mono opacity-30 uppercase tracking-widest">Scanning_Active...</span>
            </div>

            <div class="grid grid-cols-2 gap-12 mb-10">
                <div>
                    <p class="text-[9px] uppercase font-bold opacity-30 mb-2 tracking-widest">Cumulative_Hits</p>
                    <p class="text-3xl font-mono font-bold tracking-tighter" id="busuanzi_value_site_pv">----</p>
                </div>
                <div>
                    <p class="text-[9px] uppercase font-bold opacity-30 mb-2 tracking-widest">Unique_Callsigns</p>
                    <p class="text-3xl font-mono font-bold tracking-tighter" id="busuanzi_value_site_uv">----</p>
                </div>
            </div>

            <div class="bg-black/5 p-5 rounded-sm font-mono text-[11px] leading-relaxed mb-8">
                <p class="text-[#059669] font-bold mb-3 border-b border-[#059669]/20 pb-1">LAST_INCOMING_PACKET_DECODED:</p>
                <div class="space-y-1.5 opacity-80">
                    <div class="flex justify-between">
                        <span>ORIGIN:</span>
                        <span class="text-black font-bold uppercase"><span id="pkt-origin">SCANNING...</span></span>
                    </div>
                    <div class="flex justify-between">
                        <span>SOURCE_IP:</span>
                        <span class="text-black font-bold"><span id="pkt-ip">--.--.x.x</span></span>
                    </div>
                    <div class="flex justify-between">
                        <span>TIMESTAMP:</span>
                        <span class="text-black font-bold italic"><span id="pkt-time">----</span></span>
                    </div>
                    <div class="flex justify-between">
                        <span>TERMINAL:</span>
                        <span class="text-black font-bold uppercase"><span id="pkt-term">----</span></span>
                    </div>
                    <div class="flex justify-between border-t border-black/5 mt-2 pt-2">
                        <span>SIGNAL_REPORT:</span>
                        <span class="text-[#059669] font-bold animate-pulse"><span id="pkt-signal">S- // AWAITING_CARRIER</span></span>
                    </div>
                </div>
            </div>

            <div class="h-10 flex items-end gap-[2px] opacity-[0.08]">
                {Array.from({ length: 40 }).map(() => (
                    <div class="bg-black w-full" style={`height: ${Math.random() * 100}%`}></div>
                ))}
            </div>
            
            <p class="mt-4 text-[9px] opacity-20 font-mono text-center tracking-tighter">
                NOTICE: ALL DATA IS VOLATILE AND PRIVACY-PROTECTED. NO COOKIES USED.
            </p>
        </section>

        <footer class="mt-32 pt-20 border-t border-black/5 flex justify-between items-center opacity-20 text-[20px] tracking-[0.3em] uppercase">
            <span>Operator: BA8BLK</span>
            <span>Signal Out // 73</span>
        </footer>
    </main>

    <script>
        // 访客信息：通过 Cloudflare 自带的 /cdn-cgi/trace 接口实时获取，不经过第三方服务，不写 Cookie
        const $ = (id) => document.getElementById(id);

        const maskIp = (ip) => ip.includes(':')
            ? ip.split(':').slice(0, 2).join(':') + ':x:x'
            : ip.split('.').slice(0, 2).join('.') + '.x.x';

        const terminalName = (ua) => {
            const browser = /Edg\//.test(ua) ? 'EDGE' : /Firefox\//.test(ua) ? 'FIREFOX'
                : /MicroMessenger/.test(ua) ? 'WECHAT' : /Chrome\//.test(ua) ? 'CHROME'
                : /Safari\//.test(ua) ? 'SAFARI' : 'UNKNOWN';
            const os = /iPhone|iPad/.test(ua) ? 'IOS' : /Android/.test(ua) ? 'ANDROID'
                : /Windows/.test(ua) ? 'WINDOWS' : /Mac OS X/.test(ua) ? 'MACOS'
                : /Linux/.test(ua) ? 'LINUX' : 'UNKNOWN_OS';
            return `${browser} / ${os}`;
        };

        const regionName = (code) => {
            try { return new Intl.DisplayNames(['en'], { type: 'region' }).of(code) || code; }
            catch { return code; }
        };

        const tick = () => {
            $('pkt-time').textContent = new Date().toISOString().replace('T', ' ').substring(0, 19) + ' UTC';
        };
        tick();
        setInterval(tick, 1000);

        $('pkt-term').textContent = terminalName(navigator.userAgent);

        fetch('/cdn-cgi/trace', { cache: 'no-store' })
            .then((r) => { if (!r.ok) throw new Error(r.status); return r.text(); })
            .then((text) => {
                const t = Object.fromEntries(text.trim().split('\n').map((l) => l.split('=')));
                $('pkt-origin').textContent = t.loc ? `${regionName(t.loc)} // NODE ${t.colo || '---'}` : 'UNKNOWN';
                $('pkt-ip').textContent = t.ip ? maskIp(t.ip) : '--.--.x.x';
                $('pkt-signal').textContent = `S${Math.floor(Math.random() * 4) + 6} // CARRIER_DETECTED`;
            })
            .catch(() => {
                $('pkt-origin').textContent = 'NO_SIGNAL';
                $('pkt-signal').textContent = 'S0 // NO_CARRIER';
            });
    </script>

    <script async src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
</body>
</html>